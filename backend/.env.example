# --- App ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=PeopleHub API

# --- Database (async SQLAlchemy URL) ---
DATABASE_URL=postgresql+asyncpg://peoplehub:peoplehub@localhost:5432/peoplehub
DB_ECHO=false

# --- Security ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_generate_a_strong_random_secret
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change_me_generate_a_fernet_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS (comma-separated or JSON list) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Email / dev OTP ---
EXPOSE_DEV_OTP=true
EMAIL_FROM=no-reply@peoplehub.local
